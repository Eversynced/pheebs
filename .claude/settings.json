{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook session_started",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook subagent_spawned",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook context_compacted --trigger-type auto",
            "async": true
          }
        ],
        "matcher": "auto"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook context_compacted --trigger-type manual",
            "async": true
          }
        ],
        "matcher": "manual"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook session_end",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook prompt_submitted",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook tool_use_failed",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pheebs hook task_completed",
            "async": true
          }
        ]
      }
    ]
  }
}
